# Copy to .env.local to override. Values below are defaults used when unset.

# Base path for GH Pages sub-path deploys. The deploy workflow auto-sets this
# to /<repo-name>/ in CI. For local dev, leave unset (serves at /).
# VITE_BASE_PATH=/

# Map tile URL. Default: DARE/AWMC Roman-empire basemap (same AWMC cartography
# Pleiades uses, served via the Digital Atlas of the Roman Empire).
# Alternatives:
#   DARE/AWMC (default): https://dh.gu.se/tiles/imperium/{z}/{x}/{y}.png
#   ISAW Mapbox:         https://api.mapbox.com/styles/v1/isawnyu/<style-id>/tiles/{z}/{x}/{y}?access_token=<token>
#   OSM:                 https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_URL=

# Attribution string (HTML allowed). Default: AWMC.
# VITE_TILE_ATTRIBUTION=
